{
  "name": "logbook",
  "version": "0.2.2",
  "description": "Lightweight backlog directory for Claude Code: captures plans from plan mode and TodoWrite, mirrors state to disk, gives you a durable cross-session view of your work without trying to plan or execute anything itself.",
  "author": {
    "name": "youcodecowboy",
    "url": "https://github.com/youcodecowboy"
  },
  "homepage": "https://github.com/youcodecowboy/logbook",
  "repository": "https://github.com/youcodecowboy/logbook",
  "license": "MIT",
  "keywords": [
    "backlog",
    "tasks",
    "tracking",
    "productivity",
    "markdown",
    "plan-mode",
    "todowrite"
  ],
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/capture-plan.py"
          }
        ]
      },
      {
        "matcher": "TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/mirror-todos.py"
          }
        ]
      }
    ]
  }
}
